# Add the URL and anon/publishable key from your Supabase project to enable auth and live catalog data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: used only by trusted server jobs. Never expose this value to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional custom storefront domain used as the canonical metadata URL.
NEXT_PUBLIC_STORE_DOMAIN=
NEXT_PUBLIC_VENDOR_HANDLE=prime-kare
NEXT_PUBLIC_PLATFORM_NAME=SEV7N FOLD
# Replace this placeholder with the official SEV7N FOLD website before launch.
NEXT_PUBLIC_PLATFORM_URL=https://sev7nfold.example

NEXT_PUBLIC_VENDOR_CONTACT_EMAIL=
